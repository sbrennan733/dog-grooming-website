// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  // null until the user clicks the link emailed to them, proving they
  // control this address.
  emailVerified DateTime?

  dogs                    Dog[]
  bookings                Booking[]
  emailVerificationTokens EmailVerificationToken[]
}

// Only a SHA-256 hash of each token is stored (the raw token exists only in
// the emailed link), so a database leak cannot be used to verify accounts.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DogSize {
  SMALL
  MEDIUM
  LARGE
}

model Dog {
  id                    String    @id @default(cuid())
  name                  String
  breed                 String
  age                   Int
  // Decides which price applies. The default only covers dogs saved before
  // sizes existed; the dog form always asks for it.
  size                  DogSize   @default(MEDIUM)
  // Long-haired double-coated dogs pay a different (higher) price for some
  // services, e.g. the De-Shed.
  hasLongDoubleCoat     Boolean   @default(false)
  notes                 String?
  // null = assessment not yet completed; set when an admin marks it complete.
  assessmentCompletedAt DateTime?
  createdAt             DateTime  @default(now())

  ownerId  String
  owner    User      @relation(fields: [ownerId], references: [id])
  bookings Booking[]
}

model Service {
  id           String  @id @default(cuid())
  name         String  @unique
  description  String
  duration     Int // minutes
  // Prices in pence, by dog size.
  priceSmall   Int
  priceMedium  Int
  priceLarge   Int
  // Starting price (pence) for long-haired double-coated dogs, where the
  // service has one. Final price is assessed on the day.
  priceLongCoat Int?
  // Shown as "From £x" (the final price depends on the dog and its coat).
  isFromPrice  Boolean @default(false)
  // Extra pricing detail shown with the service, e.g. a coat-type surcharge.
  priceNote    String?
  deposit      Int // pence
  // Retired services stay in the database so past bookings keep working,
  // but are no longer offered.
  isActive     Boolean @default(true)
  // Identifies the mandatory first-visit assessment service.
  isAssessment Boolean @default(false)

  bookings Booking[]
}

model Booking {
  id     String @id @default(cuid())
  userId String
  dogId  String

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  scheduledAt DateTime
  status      BookingStatus @default(PENDING)

  // Snapshot of the service's price/deposit at booking time, so later
  // price changes don't retroactively affect past bookings.
  priceAtBooking   Int
  depositAtBooking Int

  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  dog     Dog      @relation(fields: [dogId], references: [id])
  payment Payment?
  consent ConsentRecord?
}

// The terms and consent a customer agreed to when making a booking, kept
// as the business's record for that visit.
model ConsentRecord {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  // The name typed as a signature.
  signedName      String
  signedAt        DateTime @default(now())
  termsVersion    String
  photoPermission Boolean
  // The exact wording agreed to, so the record stays accurate even if the
  // wording is edited later.
  snapshot        Json

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String        @unique
  amount                Int
  currency              String        @default("gbp")
  stripePaymentIntentId String        @unique
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
}

// The recurring default schedule: at most one row per day of the week.
// The weekly opening hours shown on the website (footer). They do not make
// anything bookable; see AvailableSlot.
model AvailabilityTemplate {
  id        String    @id @default(cuid())
  dayOfWeek DayOfWeek @unique
  isClosed  Boolean   @default(false)
  startTime String? // e.g. "09:00"
  endTime   String? // e.g. "17:00"
}

// A start time the admin has opened for booking on a specific date.
// Customers can only book times that exist here (and aren't already taken);
// the weekly AvailabilityTemplate is just the opening hours shown on the site.
model AvailableSlot {
  id        String   @id @default(cuid())
  date      DateTime // calendar date, stored as midnight UTC
  startTime String // "HH:mm" in business (London) time
  createdAt DateTime @default(now())

  @@unique([date, startTime])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
