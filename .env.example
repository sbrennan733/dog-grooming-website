# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string. In development `npm run db:start` starts a
# local database. In production use your host's pooled URL (see
# docs/DEPLOYMENT.md).
DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/dog_grooming?sslmode=disable"

# Only used by `prisma migrate dev` to detect schema drift (development).
SHADOW_DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/dog_grooming_shadow?sslmode=disable"

# Signs and encrypts login sessions. Generate a unique value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# The public URL of the site. Not needed in development, but REQUIRED in
# production: Auth.js refuses to run (UntrustedHost) unless it is told which
# host to trust. Example: https://www.your-domain.co.uk
AUTH_URL=""

# Email (used for confirmation emails). With nothing below set, development
# writes emails to the .dev-mail/ folder instead of sending them.
#
# Option 1 (business Outlook.com account): Microsoft Graph with OAuth.
# Personal Outlook.com accounts no longer allow password SMTP logins.
#   1. Register an app at https://entra.microsoft.com (App registrations):
#      supported accounts = "Personal Microsoft accounts only", Authentication >
#      "Allow public client flows" = Yes, API permissions > Microsoft Graph >
#      Delegated > Mail.Send.
#   2. Copy its Application (client) ID, then run:
#        node scripts/get-microsoft-refresh-token.mjs <client-id>
#      and sign in as the business account when asked.
#   3. Paste the two values it prints here. Treat the refresh token like a
#      password. Mail is sent as the account you signed in with.
# The refresh token expires after 90 days without being used.
MS_CLIENT_ID=""
MS_REFRESH_TOKEN=""

# Option 2: plain SMTP (e.g. Gmail with an App password). Ignored when the
# Microsoft values above are set.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Optional. Defaults to "Bubbles and Barks" <SMTP_USER>
EMAIL_FROM=""

# Replies to emails sent by the site always go to the business email in
# src/data/business.ts.

# Development only: set to "outbox" to write every email to the .dev-mail/
# folder instead of sending it, even if real email is configured above.
# Handy when testing so nobody gets real emails.
EMAIL_MODE=""
