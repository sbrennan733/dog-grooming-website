# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string. In development `npx prisma dev start dgw`
# provides a local database and prints a URL like this one.
DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/dog_grooming?sslmode=disable"

# Only used by `prisma migrate dev` to detect schema drift (development).
SHADOW_DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/dog_grooming_shadow?sslmode=disable"

# Signs and encrypts login sessions. Generate a unique value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# The public URL of the site. Not needed in development, but REQUIRED in
# production: Auth.js refuses to run (UntrustedHost) unless it is told which
# host to trust. Example: https://www.your-domain.co.uk
AUTH_URL=""

# Email (used for confirmation emails). Leave SMTP_HOST blank in development
# and emails are written to the .dev-mail/ folder instead of being sent.
# Gmail: turn on 2-Step Verification for the sending account, then create an
# "App password" (Google Account > Security > App passwords) and use it as
# SMTP_PASS. Never use the normal account password.
# NOTE: personal Outlook.com accounts no longer allow password (or app
# password) SMTP logins, only OAuth, so they can't be used here directly.
# Replies always go to the business email in src/data/business.ts.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS=""
# Optional. Defaults to "Bubbles and Barks" <SMTP_USER>
EMAIL_FROM=""
