# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string. In development `npx prisma dev start dgw`
# provides a local database and prints a URL like this one.
DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/dog_grooming?sslmode=disable"

# Only used by `prisma migrate dev` to detect schema drift (development).
SHADOW_DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/dog_grooming_shadow?sslmode=disable"

# Signs and encrypts login sessions. Generate a unique value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# The public URL of the site. Not needed in development, but REQUIRED in
# production: Auth.js refuses to run (UntrustedHost) unless it is told which
# host to trust. Example: https://www.your-domain.co.uk
AUTH_URL=""
